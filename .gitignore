# Generated by pg_regress on every run. The expected output IS versioned; the
# results are not, or a failing run would look like a source change.
test/results/
regression.diffs
regression.out
test/regression.diffs
test/regression.out
*.o
*.so

# PGXN release bundles built by pgxn-bundle; never source.
*.zip

# The throwaway cluster test/cluster.sh builds, and the uv cache the harness
# needs inside the project because the tree's jail does not reach ~/.cache.
.testcluster
.uv-cache
